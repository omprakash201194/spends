# Template — fill in your Google OAuth2 credentials, then seal:
#   kubeseal --cert /path/to/sealed-secrets-cert.pem \
#            --format yaml \
#            < k8s/oauth2-secret.yaml.template \
#            > k8s/oauth2-sealed-secret.yaml
#
# Google Cloud Console setup:
#   1. https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create OAuth 2.0 Client ID → Web application
#   3. Authorized JavaScript origins (add all that apply):
#        https://spends.homelab.local
#        https://spends.onelifestack.com   (if exposed via Cloudflare)
#   4. Authorized redirect URIs (add all that apply):
#        https://spends.homelab.local/api/login/oauth2/code/google
#        https://spends.onelifestack.com/api/login/oauth2/code/google
#   5. Copy the Client ID and Client Secret below

apiVersion: v1
kind: Secret
metadata:
  name: spends-oauth2-secret
  namespace: homelab
stringData:
  google-client-id: "PASTE_YOUR_GOOGLE_CLIENT_ID_HERE"
  google-client-secret: "PASTE_YOUR_GOOGLE_CLIENT_SECRET_HERE"
